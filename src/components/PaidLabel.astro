---
/* The paid-partnership label: visible text, chip style with a hairline, no
   colour (colour means verdict on this site). Long form on the study page
   (twice), short form on the index card. Wording lives in lib/studies.js. */
import { paidLabel, paidLabelShort } from '../lib/studies.js';

const { study, short = false } = Astro.props;
---

<span class:list={['paid-label', { short }]}>{short ? paidLabelShort(study) : paidLabel(study)}</span>

<style>
  .paid-label {
    display: inline-block;
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    font: 12px/1.6 var(--font-mono);
    color: var(--fg);
    background: var(--card);
  }

  .paid-label.short {
    border-radius: 100px;
    padding: 5px 11px;
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
