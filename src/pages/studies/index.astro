---
/* /studies: the index. Same layout family as /moats: .wrap, crumbs,
   lowercase h2, hairlines not containers. Gated by STUDIES_LIVE. */
import Base from '../../layouts/Base.astro';
import PaidLabel from '../../components/PaidLabel.astro';
import { studiesLive } from '../../lib/flags.js';
import { studiesNewestFirst, studyDate, studyUrl } from '../../lib/studies.js';

if (!studiesLive()) return new Response(null, { status: 404 });

const studies = studiesNewestFirst();

const title = 'Studies · long answers to one question · Can I Vibecode It?';
const description =
  'Commissioned deep dives: one paid app, one AI coding agent, a full clone attempt, and exactly where the moat holds. Paid partnerships, verdicts ours.';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'The Death List', item: 'https://canivibecodeit.com/' },
      { '@type': 'ListItem', position: 2, name: 'Studies', item: 'https://canivibecodeit.com/studies' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Studies · Can I Vibecode It?',
    itemListElement: studies.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title,
      url: studyUrl(s),
    })),
  },
];
---

<Base {title} {description} {jsonld} ogImage="/og/studies.png">
  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">the death list</a> / <span class="here">studies</span>
    </nav>

    <div class="list-head" style="padding-top: 20px;">
      <h2>studies</h2>
      <span class="note">{studies.length} {studies.length === 1 ? 'study' : 'studies'}</span>
    </div>

    <p class="studies-intro">
      The death list gives every app one line. A study gives one app the full treatment: an
      actual clone attempt, the receipts, and a map of exactly where the moat holds and where it
      does not.
    </p>

    <div class="study-list">
      {
        studies.map((s) => (
          <a class="study-card" href={`/studies/${s.slug}`}>
            <span class="sc-eyebrow">
              study no. {s.number} · {studyDate(s) ?? 'not yet published'}
            </span>
            <span class="sc-title">{s.title}</span>
            <span class="sc-desc">{s.description}</span>
            <span class="sc-foot">
              <PaidLabel study={s} short />
              <span class="sc-more">read the study →</span>
            </span>
          </a>
        ))
      }
    </div>
  </main>
</Base>

<style>
  .studies-intro {
    padding-top: 14px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 76ch;
  }

  .study-list {
    margin-top: 28px;
    border-top: 1px solid var(--border);
  }

  .study-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px 0;
    border-bottom: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
  }

  .sc-eyebrow {
    font: 11.5px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sc-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: color 0.15s ease;
  }

  .study-card:hover .sc-title {
    color: var(--primary);
  }

  .sc-desc {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 70ch;
  }

  .sc-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    padding-top: 6px;
  }

  .sc-more {
    font: 12.5px var(--font-mono);
    color: var(--primary);
  }
</style>
